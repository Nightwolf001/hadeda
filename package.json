{
  "name": "hadeda",
  "private": true,
  "description": "Hadeda \u2014 a one-tap Cape Town flapper. Mobile app, API and shared packages.",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:packages": "pnpm --filter \"./packages/**\" run build",
    "tokens": "pnpm --filter @hadeda/design-tokens run build",
    "mobile": "pnpm --filter @hadeda/mobile start",
    "api": "pnpm --filter @hadeda/api start:dev",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "postinstall": "pnpm build:packages"
  }
}
